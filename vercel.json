{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)manifest(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/rep/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manager/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ramesh\\..*"
        }
      ],
      "destination": "/rep/ramesh/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pradhish\\..*"
        }
      ],
      "destination": "/rep/pradhish/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nagaraju\\..*"
        }
      ],
      "destination": "/rep/nagaraju/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "salesofficial4\\..*"
        }
      ],
      "destination": "/rep/salesofficial4/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kavitha\\..*"
        }
      ],
      "destination": "/rep/kavitha/:path*"
    },
    {
      "source": "/manager",
      "destination": "/manager/index.html"
    },
    {
      "source": "/sales_:slug.html",
      "destination": "/rep/:slug/index.html"
    },
    {
      "source": "/rep/:slug",
      "destination": "/rep/:slug/index.html"
    }
  ]
}
